{
  "expo": {
    "name": "BUD",
    "slug": "charan-finance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "charanfinance",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/e2b55ff4-2ba2-4f7f-a80f-4a991c59b475"
    },
    "ios": {
      "bundleIdentifier": "com.charan.finance",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "BUD uses Face ID to keep your financial data private.",
        "NSCameraUsageDescription": "BUD uses the camera to photograph receipts you choose to attach to transactions.",
        "NSPhotoLibraryUsageDescription": "BUD lets you attach receipt photos from your library to transactions."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.charan.finance",
      "adaptiveIcon": {
        "backgroundColor": "#18213F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDFDFD",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0E1322",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "BUD uses Face ID to keep your financial data private."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BUD lets you attach receipt photos from your library to transactions.",
          "cameraPermission": "BUD uses the camera to photograph receipts you choose to attach to transactions.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#A4563A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e2b55ff4-2ba2-4f7f-a80f-4a991c59b475"
      },
      "router": {}
    }
  }
}
