  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:db": "tsx --test supabase/tests/database.test.ts supabase/tests/seed.test.ts supabase/tests/bank-sync.test.ts supabase/tests/friends.test.ts supabase/tests/bud-ai.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "verify:all": "npm run verify && npm run test:db",
    "doctor": "expo-doctor",
    "bundle:ios": "expo export --platform ios --output-dir dist-check",
    "db:push": "supabase db push",
    "import:sms": "tsx scripts/import-iphone-sms.ts",
    "functions:deploy": "supabase functions deploy receipt-ocr --use-api && supabase functions deploy delete-account --use-api && supabase functions deploy ingest-sms --use-api --no-verify-jwt",
    "build:dev": "eas build --profile development --platform ios",
    "build:preview": "eas build --profile preview --platform ios",
    "build:prod": "eas build --profile production --platform ios",
    "submit:ios": "eas submit --platform ios --profile production"
  },
  "private": true,
  "engines": {
    "node": ">=20.19"
  }
