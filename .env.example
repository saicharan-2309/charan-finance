# Copy to .env (never commit .env). Only PUBLIC values belong here — they are
# compiled into the app. Find both in Supabase Dashboard → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" / "publishable" key. NEVER put the service_role / secret key here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Only for `npm run test:db` — a DISPOSABLE local PostgreSQL, never Supabase.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
